config sftpgo 'config'
	option enabled '0'
	option delay '10'

	# 目录
	option config_dir '/etc/sftpgo'
	option data_dir '/srv/sftpgo/data'
	option backups_dir '/srv/sftpgo/backups'

	# 日志
	option log_level 'info'
	option log_file '/var/log/sftpgo/sftpgo.log'
	option log_max_size '10'
	option log_max_backups '3'
	option log_max_age '28'
	option log_compress '1'

	# SFTP (SSH) 监听
	option sftp_enabled '1'
	option sftp_port '2022'
	option sftp_address ''

	# FTP/FTPS 监听
	option ftp_enabled '0'
	option ftp_port '2121'
	option ftp_address ''

	# WebDAV 监听
	option webdav_enabled '0'
	option webdav_port '2080'
	option webdav_address ''

	# HTTP(S) WebAdmin/WebClient/REST API 监听
	option httpd_port '8090'
	option httpd_address ''

	# 数据源（provider）：sqlite（默认，与 SFTPGo 官方默认一致，生态工具
	# 成熟，可直接用 sqlite3 命令行查库） / bolt（纯 Go 内嵌 KV，无外部
	# 工具但轻量） / memory（不持久化，仅测试）。
	# db_name 留空时，init 脚本会按 provider 自动选择互不冲突的文件名
	# （sqlite -> sftpgo.sqlite3，bolt -> sftpgo.bolt），避免同一个文件名
	# 在两种驱动之间切换时因文件头格式不一致报 "invalid database"。
	option data_provider 'sqlite'
	option db_name ''

	# 首次启动自动创建管理员账号
	option create_default_admin '1'
	option default_admin_user 'admin'
	option default_admin_password ''
