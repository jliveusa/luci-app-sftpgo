#!/bin/sh /etc/rc.common
# SFTPGo OpenWrt procd service
# SFTPGo's native JSON is the only runtime configuration source.

START=90
STOP=10
USE_PROCD=1

PROG=/usr/bin/sftpgo
UCI_CFG=sftpgo
SHARE_DIR=/usr/share/sftpgo
DEFAULT_JSON="$SHARE_DIR/sftpgo.default.json"
CONFIG_DIR=/etc/sftpgo

ensure_dir() {
	local dir="$1"
	[ -n "$dir" ] || return 0
	[ -d "$dir" ] || mkdir -p "$dir" || return 1
	chown sftpgo:sftpgo "$dir" 2>/dev/null || true
}

ensure_assets() {
	local dir="$1"
	local name target
	for name in templates static openapi; do
		target="$SHARE_DIR/$name"
		[ -e "$dir/$name" ] && continue
		[ -e "$target" ] || {
			logger -t sftpgo "missing packaged asset directory: $target"
			return 1
		}
		ln -s "$target" "$dir/$name" 2>/dev/null || [ -e "$dir/$name" ] || return 1
	done
	return 0
}

ensure_native_config() {
	local dir="$1"
	local file="$dir/sftpgo.json"

	if [ ! -f "$file" ]; then
		[ -f "$DEFAULT_JSON" ] || {
			logger -t sftpgo "missing default config: $DEFAULT_JSON"
			return 1
		}
		cp "$DEFAULT_JSON" "$file" || return 1
	fi

	chmod 600 "$file" 2>/dev/null || true
	chown sftpgo:sftpgo "$file" 2>/dev/null || true
	return 0
}

ensure_runtime_ownership() {
	local dir="$1"
	local file
	for file in sftpgo.db sftpgo.db-wal sftpgo.db-shm id_rsa id_ecdsa id_ed25519; do
		[ -e "$dir/$file" ] || continue
		chown sftpgo:sftpgo "$dir/$file" 2>/dev/null || true
	done
}

start_instance() {
	local cfg="$1"
	local enabled delay uptime

	config_get_bool enabled "$cfg" enabled 0
	[ "$enabled" = "1" ] || return 0

	config_get delay "$cfg" delay 0
	if [ "$delay" -gt 0 ]; then
		uptime="$(awk -F. '{print $1}' /proc/uptime)"
		[ "$uptime" -lt 120 ] && sleep "$delay"
	fi

	ensure_dir "$CONFIG_DIR" || return 1
	ensure_assets "$CONFIG_DIR" || return 1
	ensure_native_config "$CONFIG_DIR" || return 1
	ensure_runtime_ownership "$CONFIG_DIR"

	logger -t sftpgo "starting: config=$CONFIG_DIR/sftpgo.json"

	procd_open_instance
	procd_set_param command \
		"$PROG" \
		serve \
		--config-dir "$CONFIG_DIR" \
		--config-file "$CONFIG_DIR/sftpgo.json"
	procd_set_param user sftpgo
	procd_set_param group sftpgo
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

start_service() {
	config_load "$UCI_CFG"
	config_foreach start_instance sftpgo
}

service_triggers() {
	procd_add_reload_trigger "$UCI_CFG"
}

reload_service() {
	stop
	start
}
