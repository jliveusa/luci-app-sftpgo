#!/bin/sh /etc/rc.common
#
# SFTPGo procd init script for OpenWrt
#
# 配置策略：SFTPGo 本身使用原生 /etc/sftpgo/sftpgo.json。
# UCI 只保存 OpenWrt 服务层设置以及日志/首次管理员引导参数。
# 不再用 UCI 逐项覆盖 SFTPGo 的协议、数据库、TLS、OIDC、MFA 等原生配置，
# 避免 LuCI 与 sftpgo.json 形成两个互相冲突的配置中心。

START=90
STOP=10
USE_PROCD=1

NAME=sftpgo
PROG=/usr/bin/sftpgo
UCI_CFG=sftpgo

SHARE_DIR=/usr/share/sftpgo
DEFAULT_JSON=$SHARE_DIR/sftpgo.default.json

# SFTPGo 默认配置目录。UCI 中仍保留 config_dir 以兼容旧版本/自定义部署，
# 但新 LuCI 不再主动修改它。
get_config_dir() {
	local dir
	config_get dir config config_dir '/etc/sftpgo'
	echo "$dir"
}

gen_password() {
	# 16 字节随机口令，base64 后压缩为字母数字。
	head -c 16 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | cut -c1-16
}

ensure_dir() {
	local dir="$1"
	[ -n "$dir" ] || return 0
	[ -d "$dir" ] || mkdir -p "$dir"
	# 不再递归 chown：config_dir 里可能包含用户自带证书/私钥，
	# 避免 LuCI/SFTPGo 启动时覆盖其原有权限。
	chown sftpgo:sftpgo "$dir" 2>/dev/null
}

prepare_dirs() {
	local cfg="$1"
	local config_dir log_file

	config_get config_dir "$cfg" config_dir '/etc/sftpgo'
	config_get log_file "$cfg" log_file '/var/log/sftpgo/sftpgo.log'

	ensure_dir "$config_dir"
	ensure_dir "$(dirname "$log_file")"
}

# /etc/sftpgo/sftpgo.json 是运行时用户配置，不再作为 opkg conffile 随包安装。
# 仅当文件不存在且服务真正启动时，才从只读默认模板创建一份。
# 这样升级软件包只更新 /usr/share/sftpgo/sftpgo.default.json，不会触碰用户 JSON。
ensure_native_config() {
	local config_dir="$1"
	local config_file="$config_dir/sftpgo.json"

	[ -f "$config_file" ] || {
		[ -f "$DEFAULT_JSON" ] || {
			logger -t sftpgo "missing default config: $DEFAULT_JSON"
			return 1
		}
		cp "$DEFAULT_JSON" "$config_file" || return 1
	}

	# SFTPGo 进程以 sftpgo 用户运行，配置文件可能含数据库/OIDC/KMS 等敏感信息。
	chmod 600 "$config_file" 2>/dev/null
	chown sftpgo:sftpgo "$config_file" 2>/dev/null
	return 0
}

# 首次启用且未设置管理员密码时，自动生成一次并持久化到 UCI + 私有文件。
# 这里只负责 OpenWrt 层的首次引导参数；SFTPGo 的完整服务配置仍来自 JSON。
ensure_admin_password() {
	local cfg="$1"
	local create_admin admin_user admin_pass cfgdir credfile

	config_get_bool create_admin "$cfg" create_default_admin 1
	[ "$create_admin" = "1" ] || return 0

	config_get admin_user "$cfg" default_admin_user 'admin'
	config_get admin_pass "$cfg" default_admin_password ''

	if [ -z "$admin_pass" ]; then
		admin_pass="$(gen_password)"
		uci -q set sftpgo.config.default_admin_password="$admin_pass"
		uci -q commit sftpgo
	fi

	config_get cfgdir "$cfg" config_dir '/etc/sftpgo'
	credfile="$cfgdir/.initial_admin_credentials"

	# 已存在的凭证提示不重复覆盖，避免每次重启都把页面上显示的密码改掉。
	[ -f "$credfile" ] && return 0

	umask 077
	cat > "$credfile" <<-EOF
	# 由 luci-app-sftpgo 自动生成，仅在首次创建管理员账号时写入。
	# 登录 WebAdmin 后请尽快修改密码，此文件可以安全删除。
	username: $admin_user
	password: $admin_pass
	EOF
	chmod 600 "$credfile" 2>/dev/null
	chown sftpgo:sftpgo "$credfile" 2>/dev/null
}

build_env() {
	local cfg="$1"
	local config_dir
	config_get config_dir "$cfg" config_dir '/etc/sftpgo'

	local log_level log_file log_max_size log_max_backups log_max_age log_compress
	config_get log_level "$cfg" log_level 'info'
	config_get log_file "$cfg" log_file '/var/log/sftpgo/sftpgo.log'
	config_get log_max_size "$cfg" log_max_size '10'
	config_get log_max_backups "$cfg" log_max_backups '3'
	config_get log_max_age "$cfg" log_max_age '28'
	config_get_bool log_compress "$cfg" log_compress 1

	local create_admin admin_user admin_pass
	config_get_bool create_admin "$cfg" create_default_admin 1
	config_get admin_user "$cfg" default_admin_user 'admin'
	config_get admin_pass "$cfg" default_admin_password ''

	# 明确指定 JSON 配置文件，防止未来工作目录变化导致读错配置。
	procd_append_param env "SFTPGO_CONFIG_DIR=$config_dir"
	procd_append_param env "SFTPGO_CONFIG_FILE=sftpgo.json"

	# 日志参数属于 SFTPGo CLI/env 层，并不属于 sftpgo.json。
	procd_append_param env "SFTPGO_LOG_FILE_PATH=$log_file"
	procd_append_param env "SFTPGO_LOG_LEVEL=$log_level"
	procd_append_param env "SFTPGO_LOG_MAX_SIZE=$log_max_size"
	procd_append_param env "SFTPGO_LOG_MAX_BACKUPS=$log_max_backups"
	procd_append_param env "SFTPGO_LOG_MAX_AGE=$log_max_age"
	[ "$log_compress" = "1" ] && procd_append_param env "SFTPGO_LOG_COMPRESS=1"

	# OpenWrt 包安装的 WebAdmin/WebClient 资源固定在只读 /usr/share/sftpgo，
	# 这是包级资源路径，不让用户 JSON 覆盖，避免升级后找不到模板。
	procd_append_param env "SFTPGO_HTTPD__TEMPLATES_PATH=$SHARE_DIR/templates"
	procd_append_param env "SFTPGO_HTTPD__STATIC_FILES_PATH=$SHARE_DIR/static"
	procd_append_param env "SFTPGO_HTTPD__OPENAPI_PATH=$SHARE_DIR/openapi"
	procd_append_param env "SFTPGO_SMTP__TEMPLATES_PATH=$SHARE_DIR/templates"

	# 首次管理员只是 bootstrap 机制，真正的 SFTPGo 服务配置不再在这里重复。
	if [ "$create_admin" = "1" ]; then
		procd_append_param env "SFTPGO_DATA_PROVIDER__CREATE_DEFAULT_ADMIN=1"
		procd_append_param env "SFTPGO_DEFAULT_ADMIN_USERNAME=$admin_user"
		procd_append_param env "SFTPGO_DEFAULT_ADMIN_PASSWORD=$admin_pass"
	fi

	# 旧版 UCI 的协议监听器/数据库字段在本版本中完全忽略。
	# 这里绝不把它们转成 SFTPGO_* 环境变量，确保 sftpgo.json 是唯一业务配置源。

	logger -t sftpgo "starting: config=$config_dir/sftpgo.json admin_user=$admin_user"
}

start_instance() {
	local cfg="$1"
	local enabled
	config_get_bool enabled "$cfg" enabled 0
	[ "$enabled" = "1" ] || return 0

	local delay
	config_get delay "$cfg" delay 10
	if [ "$delay" -gt 0 ]; then
		local uptime
		uptime=$(awk -F. '{print $1}' /proc/uptime)
		[ "$uptime" -lt 120 ] && sleep "$delay"
	fi

	prepare_dirs "$cfg"

	local config_dir
	config_get config_dir "$cfg" config_dir '/etc/sftpgo'
	ensure_native_config "$config_dir" || return 1
	ensure_admin_password "$cfg"

	procd_open_instance "$NAME"
	procd_set_param command "$PROG" serve
	build_env "$cfg"

	procd_set_param user sftpgo
	procd_set_param group sftpgo
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
	procd_close_instance
}

start_service() {
	config_load "$UCI_CFG"
	config_foreach start_instance sftpgo
}

service_triggers() {
	procd_add_reload_trigger "$UCI_CFG"
}

reload_service() {
	stop
	start
}
