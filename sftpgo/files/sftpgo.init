#!/bin/sh /etc/rc.common
#
# SFTPGo procd init script for OpenWrt
#
# 配置策略：不落地/维护完整的 sftpgo.json，而是让 sftpgo 使用内置默认值，
# 所有需要暴露给 LuCI 的选项通过环境变量覆盖（SFTPGo 官方推荐方式，见
# https://docs.sftpgo.com/latest/env-vars/），避免升级后需要手动合并配置文件。

START=90
STOP=10
USE_PROCD=1

NAME=sftpgo
PROG=/usr/bin/sftpgo
UCI_CFG=sftpgo

gen_password() {
	# 16 字节随机口令，base64 精简为字母数字
	head -c 16 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | cut -c1-16
}

ensure_dirs() {
	local dir="$1"
	[ -d "$dir" ] || mkdir -p "$dir"
	chown -R sftpgo:sftpgo "$dir"
}

# 首次启用且未设置管理员密码时，自动生成一次并持久化到 UCI + 私有文件，
# 之后不再变化，避免每次重启都换密码导致失联。
ensure_admin_password() {
	local create_admin admin_user admin_pass
	config_get_bool create_admin "$UCI_CFG" create_default_admin 1
	[ "$create_admin" = "1" ] || return 0

	config_get admin_user "$UCI_CFG" default_admin_user 'admin'
	config_get admin_pass "$UCI_CFG" default_admin_password ''

	if [ -z "$admin_pass" ]; then
		admin_pass="$(gen_password)"
		uci -q set sftpgo.config.default_admin_password="$admin_pass"
		uci -q commit sftpgo
	fi

	local cfgdir
	config_get cfgdir "$UCI_CFG" config_dir '/etc/sftpgo'
	umask 077
	cat > "$cfgdir/.initial_admin_credentials" <<-EOF
	# 由 luci-app-sftpgo 自动生成，仅在首次创建管理员账号时写入。
	# 登录 WebAdmin 后请尽快修改密码，此文件可以安全删除。
	username: $admin_user
	password: $admin_pass
	EOF
	chown sftpgo:sftpgo "$cfgdir/.initial_admin_credentials"
}

build_env() {
	local cfg="$1"

	local config_dir data_dir backups_dir
	config_get config_dir "$cfg" config_dir '/etc/sftpgo'
	config_get data_dir "$cfg" data_dir '/srv/sftpgo/data'
	config_get backups_dir "$cfg" backups_dir '/srv/sftpgo/backups'

	local log_level log_file log_max_size log_max_backups log_max_age log_compress
	config_get log_level "$cfg" log_level 'info'
	config_get log_file "$cfg" log_file '/var/log/sftpgo/sftpgo.log'
	config_get log_max_size "$cfg" log_max_size '10'
	config_get log_max_backups "$cfg" log_max_backups '3'
	config_get log_max_age "$cfg" log_max_age '28'
	config_get_bool log_compress "$cfg" log_compress 1

	local sftp_enabled sftp_port sftp_address
	config_get_bool sftp_enabled "$cfg" sftp_enabled 1
	config_get sftp_port "$cfg" sftp_port '2022'
	config_get sftp_address "$cfg" sftp_address ''

	local ftp_enabled ftp_port ftp_address
	config_get_bool ftp_enabled "$cfg" ftp_enabled 0
	config_get ftp_port "$cfg" ftp_port '2121'
	config_get ftp_address "$cfg" ftp_address ''

	local webdav_enabled webdav_port webdav_address
	config_get_bool webdav_enabled "$cfg" webdav_enabled 0
	config_get webdav_port "$cfg" webdav_port '2080'
	config_get webdav_address "$cfg" webdav_address ''

	local httpd_port httpd_address
	config_get httpd_port "$cfg" httpd_port '8090'
	config_get httpd_address "$cfg" httpd_address ''

	local data_provider db_name
	config_get data_provider "$cfg" data_provider 'bolt'
	config_get db_name "$cfg" db_name 'sftpgo.db'

	local create_admin admin_user admin_pass
	config_get_bool create_admin "$cfg" create_default_admin 1
	config_get admin_user "$cfg" default_admin_user 'admin'
	config_get admin_pass "$cfg" default_admin_password ''

	procd_append_param env "SFTPGO_CONFIG_DIR=$config_dir"
	procd_append_param env "SFTPGO_LOG_FILE_PATH=$log_file"
	procd_append_param env "SFTPGO_LOG_LEVEL=$log_level"
	procd_append_param env "SFTPGO_LOG_MAX_SIZE=$log_max_size"
	procd_append_param env "SFTPGO_LOG_MAX_BACKUPS=$log_max_backups"
	procd_append_param env "SFTPGO_LOG_MAX_AGE=$log_max_age"
	[ "$log_compress" = "1" ] && procd_append_param env "SFTPGO_LOG_COMPRESS=1"

	# SFTP (SSH) binding[0]
	if [ "$sftp_enabled" = "1" ]; then
		procd_append_param env "SFTPGO_SFTPD__BINDINGS__0__PORT=$sftp_port"
	else
		procd_append_param env "SFTPGO_SFTPD__BINDINGS__0__PORT=0"
	fi
	[ -n "$sftp_address" ] && procd_append_param env "SFTPGO_SFTPD__BINDINGS__0__ADDRESS=$sftp_address"

	# FTP binding[0] (0 = disabled, 上游默认即禁用)
	if [ "$ftp_enabled" = "1" ]; then
		procd_append_param env "SFTPGO_FTPD__BINDINGS__0__PORT=$ftp_port"
		[ -n "$ftp_address" ] && procd_append_param env "SFTPGO_FTPD__BINDINGS__0__ADDRESS=$ftp_address"
	fi

	# WebDAV binding[0]
	if [ "$webdav_enabled" = "1" ]; then
		procd_append_param env "SFTPGO_WEBDAVD__BINDINGS__0__PORT=$webdav_port"
		[ -n "$webdav_address" ] && procd_append_param env "SFTPGO_WEBDAVD__BINDINGS__0__ADDRESS=$webdav_address"
	fi

	# HTTP(S) binding[0]：WebAdmin / WebClient / REST API
	procd_append_param env "SFTPGO_HTTPD__BINDINGS__0__PORT=$httpd_port"
	[ -n "$httpd_address" ] && procd_append_param env "SFTPGO_HTTPD__BINDINGS__0__ADDRESS=$httpd_address"

	# 数据源
	procd_append_param env "SFTPGO_DATA_PROVIDER__DRIVER=$data_provider"
	procd_append_param env "SFTPGO_DATA_PROVIDER__NAME=$db_name"
	procd_append_param env "SFTPGO_DATA_PROVIDER__USERS_BASE_DIR=$data_dir"
	procd_append_param env "SFTPGO_DATA_PROVIDER__BACKUPS_PATH=$backups_dir"

	if [ "$create_admin" = "1" ]; then
		procd_append_param env "SFTPGO_DATA_PROVIDER__CREATE_DEFAULT_ADMIN=1"
		procd_append_param env "SFTPGO_DEFAULT_ADMIN_USERNAME=$admin_user"
		procd_append_param env "SFTPGO_DEFAULT_ADMIN_PASSWORD=$admin_pass"
	fi

	ensure_dirs "$config_dir"
	ensure_dirs "$data_dir"
	ensure_dirs "$backups_dir"
	ensure_dirs "$(dirname "$log_file")"
}

start_instance() {
	local cfg="$1"
	local enabled
	config_get_bool enabled "$cfg" enabled 0
	[ "$enabled" = "1" ] || return 0

	local delay
	config_get delay "$cfg" delay 10
	if [ "$delay" -gt 0 ]; then
		local uptime
		uptime=$(awk -F. '{print $1}' /proc/uptime)
		[ "$uptime" -lt 120 ] && sleep "$delay"
	fi

	ensure_admin_password

	procd_open_instance "$NAME"
	procd_set_param command "$PROG" serve

	build_env "$cfg"

	procd_set_param user sftpgo
	procd_set_param group sftpgo
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
	procd_close_instance
}

start_service() {
	config_load "$UCI_CFG"
	config_foreach start_instance sftpgo
}

service_triggers() {
	procd_add_reload_trigger "$UCI_CFG"
}

reload_service() {
	stop
	start
}
