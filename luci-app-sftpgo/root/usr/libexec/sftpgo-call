#!/bin/sh
# 供 luci-app-sftpgo 的 log.js 通过 fs.exec() 调用。

. /lib/functions.sh

get_log_file() {
	local log_file
	config_load sftpgo
	config_get log_file config log_file '/var/log/sftpgo/sftpgo.log'
	echo "$log_file"
}

case "$1" in
	"get_logs")
		LOGFILE="$(get_log_file)"
		if [ -n "$LOGFILE" ] && [ -f "$LOGFILE" ]; then
			tail -n 300 "$LOGFILE"
		else
			logread -l 300 2>/dev/null | grep -i sftpgo
		fi
		[ $? -eq 0 ] || echo "No sftpgo logs found"
		;;
	"clear_logs")
		LOGFILE="$(get_log_file)"
		if [ -n "$LOGFILE" ] && [ -f "$LOGFILE" ]; then
			: > "$LOGFILE"
			echo "Logs cleared"
		else
			/etc/init.d/log restart >/dev/null 2>&1
			echo "Logs cleared"
		fi
		;;
	*)
		echo "usage: $0 {get_logs|clear_logs}"
		exit 1
		;;
esac
