{
	"luci-app-sftpgo": {
		"description": "Grant UCI access for luci-app-sftpgo",
		"read": {
			"uci": [ "sftpgo" ],
			"file": {
				"/etc/init.d/sftpgo": [ "exec" ],
				"/usr/bin/sftpgo": [ "exec" ],
				"/usr/libexec/sftpgo-call": [ "exec" ],
				"/usr/share/rpcd/ucode/luci.sftpgo": [ "exec" ],
				"/bin/pidof": [ "exec" ],
				"/bin/ps": [ "exec" ],
				"/bin/ash": [ "exec" ],
				"/bin/logread": [ "exec" ],
				"/var/log/*": [ "read" ]
			},
			"ubus": {
				"rc": [ "*" ],
				"service": [ "list" ],
				"luci.sftpgo": [ "*" ],
				"network.interface.*": [ "status" ],
				"network": [ "*" ]
			}
		},
		"write": {
			"uci": [ "sftpgo" ],
			"ubus": {
				"luci.sftpgo": [ "*" ]
			}
		}
	}
}
