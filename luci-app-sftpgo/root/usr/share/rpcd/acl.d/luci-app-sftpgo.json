{
  "luci-app-sftpgo": {
    "description": "Grant access for luci-app-sftpgo",
    "read": {
      "uci": [ "sftpgo" ],
      "file": {
        "/etc/init.d/sftpgo": [ "exec" ],
        "/usr/bin/sftpgo": [ "exec" ],
        "/bin/pidof": [ "exec" ],
        "/sbin/logread": [ "exec" ],
        "/usr/share/rpcd/ucode/luci.sftpgo": [ "exec" ]
      },
      "ubus": {
        "luci.sftpgo": [ "*" ]
      }
    },
    "write": {
      "uci": [ "sftpgo" ],
      "ubus": {
        "luci.sftpgo": [ "*" ]
      }
    }
  }
}
