msgid "SFTPGo"
msgstr "SFTPGo"

msgid "SFTPGo is a fully featured SFTP/FTP/WebDAV server with a built-in WebAdmin and WebClient. This page only manages the daemon and its listener ports; user/folder/permission management is done in the WebAdmin itself."
msgstr "SFTPGo 是一个功能完善的 SFTP/FTP/WebDAV 服务端，自带 WebAdmin 与 WebClient。本页面仅管理守护进程本身及其监听端口，用户/目录/权限的管理请在 WebAdmin 中进行。"

msgid "Overview"
msgstr "总览"

msgid "Base Setting"
msgstr "基本设置"

msgid "Log"
msgstr "日志"

msgid "SFTPGo Service Not Running"
msgstr "SFTPGo 服务未运行"

msgid "SFTPGo is disabled. Enable it on the Base Setting page."
msgstr "SFTPGo 未启用，请在“基本设置”页面开启。"

msgid "SFTPGo WebAdmin"
msgstr "SFTPGo 管理面板"

msgid "Due to browser security policies, the plain-HTTP SFTPGo interface cannot be embedded from an HTTPS LuCI session."
msgstr "由于浏览器安全策略限制，当前 LuCI 处于 HTTPS 会话下，无法内嵌 HTTP 明文的 SFTPGo 界面。"

